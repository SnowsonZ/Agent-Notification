#!/bin/sh
# 派发脚本入口（harness/dispatch.py）：把已合并的任务书交给执行方，在槽位 worktree 中完成并开 PR。
# 解释器与 bin/verify 相同：优先开发包运行时 venv，没有时退回 PATH 上的 python3。
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
runtime="$root/scratch/iterm-probe-venv/bin/python"
if [ ! -x "$runtime" ]; then
    runtime=$(command -v python3)
fi
exec "$runtime" "$root/harness/dispatch.py" "$@"
