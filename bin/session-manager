#!/bin/sh
set -eu
task_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
if [ -d "$task_root/pylib" ]; then
    # 发布包：task_root 是 .app/Contents/Resources，依赖随包，解释器用本机 python3。
    # /usr/bin/python3 需要 Command Line Tools，未安装时只是个会弹窗的桩，放到最后并先验证。
    runtime=""
    for candidate in /opt/homebrew/bin/python3 /usr/local/bin/python3 /usr/bin/python3; do
        if [ -x "$candidate" ] && "$candidate" -c 'import sys; sys.exit(sys.version_info < (3, 9))' 2>/dev/null; then
            runtime="$candidate"
            break
        fi
    done
    if [ -z "$runtime" ]; then
        echo "Missing runtime: python3 (3.9+) not found; install Xcode Command Line Tools or Homebrew python" >&2
        exit 1
    fi
    export PYTHONPATH="$task_root/pylib${PYTHONPATH:+:$PYTHONPATH}"
    export PYTHONDONTWRITEBYTECODE=1  # 不往已签名的 bundle 里写 __pycache__
    app_bundle=$(CDPATH= cd -- "$task_root/../.." && pwd)
else
    runtime="$task_root/scratch/iterm-probe-venv/bin/python"
    if [ ! -x "$runtime" ]; then
        echo "Missing runtime: $runtime" >&2
        exit 1
    fi
    app_bundle="$task_root/build/Agent Notification.app"
fi
action=${1:-help}
if [ "$#" -gt 0 ]; then shift; fi
case "$action" in
    pi|kimi|opencode|agy)
        exec "$runtime" "$task_root/scripts/session_binding.py" run "$action" "$@"
        ;;
    list)
        exec "$runtime" "$task_root/scripts/session_binding.py" list "$@"
        ;;
    focus)
        if [ "$#" -ne 2 ]; then
            echo "Usage: session-manager focus RUN_ID AGENT_SESSION_ID" >&2
            exit 2
        fi
        exec "$runtime" "$task_root/scripts/iterm_probe.py" --run-id "$1" --agent-session-id "$2" --activate
        ;;
    setup-kimi)
        exec "$runtime" "$task_root/scripts/session_binding.py" install-kimi-hooks
        ;;
    setup-agy)
        exec "$runtime" "$task_root/scripts/session_binding.py" install-agy-hooks
        ;;
    zcode-focus)
        exec "$runtime" "$task_root/scripts/zcode_focus.py" "$@"
        ;;
    inbox)
        exec "$runtime" "$task_root/scripts/inbox.py" "$@"
        ;;
    app)
        exec /usr/bin/open "$app_bundle"
        ;;
    permissions)
        if [ ! -d "$app_bundle" ]; then
            echo "Missing app: $app_bundle (run scripts/build_inbox_app.py first)" >&2
            exit 1
        fi
        /usr/bin/open -R "$app_bundle"
        /usr/bin/open "x-apple.systempreferences:com.apple.preference.security?Privacy_Accessibility"
        echo "在系统设置「隐私与安全性 → 辅助功能」中，把 Finder 里的 Agent Notification.app 拖进右侧列表。"
        ;;
    help|--help|-h)
        echo "Usage: session-manager pi|kimi|opencode|agy [agent options]"
        echo "       session-manager list"
        echo "       session-manager focus RUN_ID AGENT_SESSION_ID"
        echo "       session-manager setup-kimi | setup-agy"
        echo "       session-manager zcode-focus TASK_ID [--describe]"
        echo "       session-manager inbox rows --all --refresh | sync | setup | open ID | ack ID --revision N"
    echo "       session-manager inbox daily-report [--date YYYY-MM-DD] | --overview [--days N] [--top N]"
        echo "       session-manager app"
        echo "       session-manager permissions"
        ;;
    *) echo "Unknown action: $action" >&2; exit 2 ;;
esac
